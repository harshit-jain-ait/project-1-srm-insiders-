# Portfolify Master Environment Configuration Template
# Copy this file to .env.local to configure your local or staging environment.
# NEVER commit real credentials, production secrets, or customer keys to version control.

# ==============================================================================
# 1. CORE APPLICATION HOST & ROUTING
# ==============================================================================
# The public base URL of the Portfolify web application.
# Used for canonical SEO URLs, sitemaps, OpenGraph metadata, and public links.
# Client/Server: Publicly exposed via NEXT_PUBLIC_ prefix
# Required: YES (Defaults to http://localhost:3000 if omitted)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Target CNAME for Custom Apex / Subdomain DNS configurations.
# Used when users connect their personal domains (e.g., portfolio.johndoe.com).
# Client/Server: Publicly exposed via NEXT_PUBLIC_ prefix
# Optional (Defaults to cname.portfolify.com)
NEXT_PUBLIC_APP_CNAME="cname.portfolify.com"

# ==============================================================================
# 2. PERSISTENCE & DATABASE
# ==============================================================================
# Path to SQLite database file on disk.
# Automatically applies migrations 001-004 on startup in WAL mode with foreign keys.
# Set to ":memory:" for isolated unit/integration test runs.
# Server-only.
# Required: YES (Defaults to .data/portfolify.db)
PORTFOLIO_DB_PATH=".data/portfolify.db"

# ==============================================================================
# 3. AI GENERATION & CONTENT ASSISTANT (Google Gemini)
# ==============================================================================
# Google Gemini API Key for grounded portfolio generation, content assist, and restyling.
# Obtain from Google AI Studio: https://aistudio.google.com/
# Server-only.
# Required for AI features: YES (When omitted, AI endpoints return clear HTTP 503 config errors)
GEMINI_API_KEY=""

# Alternatively, GOOGLE_GENAI_API_KEY is also accepted
# GOOGLE_GENAI_API_KEY=""

# Gemini model identifier. Recommended: gemini-3.5-flash-lite or gemini-2.5-flash
# Server-only.
# Optional (Defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# ==============================================================================
# 4. EMAIL DISPATCH & NOTIFICATIONS (Optional)
# ==============================================================================
# API key for Resend email dispatch for visitor contact submissions.
# When omitted, messages are safely persisted in the portfolio database inbox
# without crashing or losing visitor submissions.
# Server-only.
# Optional (Defaults to inbox-only storage)
RESEND_API_KEY=""

# From email address for notification delivery
# Optional (Defaults to Portfolify Notifications <notifications@portfolify.dev>)
EMAIL_FROM="Portfolify Notifications <notifications@portfolify.dev>"

# Optional SMTP Host for custom SMTP relays
# SMTP_HOST=""

# ==============================================================================
# 5. AUTHENTICATION & SECURITY
# ==============================================================================
# Cryptographic secret for signing session tokens and gateway claims.
# Generate with `openssl rand -hex 32`.
# Server-only.
# Optional for local anonymous draft mode; Required for production multi-tenant auth.
AUTH_SECRET=""
