# Portfolify Environment Configuration Template
# Copy this file to .env.local to configure your local development environment.
# NEVER commit real credentials or production secrets to version control.

# AI Assistant Integration (Required for /api/ai/generate)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Application Host URL (Used for generating canonical and shareable links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Durable Database Configuration
# Path to SQLite database file. Defaults to .data/portfolify.db within project root.
# For memory-only mode in isolated automated tests, set to ":memory:"
PORTFOLIO_DB_PATH=".data/portfolify.db"

# Authentication & Session Security (Optional for anonymous drafts; required for account auth)
# Generate using `openssl rand -hex 32`
AUTH_SECRET=""
