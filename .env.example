# Portfolify Environment Configuration Template
# Copy this file to .env.local to configure your local development environment.

# AI Assistant Integration (Required for /api/ai/generate)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Application Host URL (Used for generating canonical and shareable links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Persistence Storage Directory (Defaults to .data/portfolios.json inside project root)
# PORTFOLIO_STORAGE_PATH=".data/portfolios.json"
